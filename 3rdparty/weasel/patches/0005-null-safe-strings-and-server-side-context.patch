 using namespace weasel;
 
+// [weasel-fluent] NULL 安全的 UTF-8 → UTF-16 转换。
+//
+// 上游到处直接写 `u8tow(x)`（宏 = string_to_wstring(x, CP_UTF8)），而那个函数的
+// 参数是 `const std::string&` —— 从 `const char*` 构造 std::string 时传 NULL 是
+// 未定义行为：MSVC 会抛 std::invalid_argument，在服务端线程里就变成 0xC0000409
+// 直接崩掉整个进程（实测：候选窗发一个按键就崩）。
+//
+// librime 在「会话没有有效方案」「提交串为空」「候选词没有文本」等情况下**确实**
+// 会给出 NULL 指针，所以这里统一改走空指针安全的包装。
+static inline std::wstring u8tow_safe(const char* s) {
+  return s ? u8tow(s) : std::wstring();
+}
